<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.holon-platform.multi-tenancy</groupId>
        <artifactId>holon-multi-tenancy-root</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>holon-saas-demo</artifactId>
    <name>Holon SaaS :: Demo Application</name>
    <description>
        Runnable Vaadin Flow demo of the holon-saas framework: self-service tenant sign-up on
        schema-per-tenant H2, tenant login, user invitation, invitation acceptance, and
        role-driven view- and method-level authorization.
    </description>

    <properties>
        <vaadin.version>25.2.1</vaadin.version>
        <!-- A demo application is never published to a repository. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-bom</artifactId>
                <version>${vaadin.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
            Pulls in every holon-saas module (core, data, onboarding, signup, users,
            invitations, permissions, security, ...) plus spring-boot-starter-security.
            It deliberately does NOT bring JPA, a Datastore, a JDBC driver or Flyway —
            those are the application's choice and are declared explicitly below.
        -->
        <dependency>
            <groupId>com.holon-platform.multi-tenancy</groupId>
            <artifactId>holon-starter-multi-tenancy</artifactId>
        </dependency>

        <!-- F23: the Redis-backed tenant details cache and distributed rate limiter. Both
             auto-configurations are inert until a RedisConnectionFactory exists, which the
             starter below supplies once spring.data.redis.* is set. -->
        <dependency>
            <groupId>com.holon-platform.multi-tenancy</groupId>
            <artifactId>holon-multi-tenant-cache-redis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!--
            A real redis-server, started in-process from a bundled binary, so the demo needs
            no Docker and no separately installed Redis. Compile scope rather than test scope
            on purpose: the running application demonstrates F23 in the browser, not only in a
            test. A deployment would of course point spring.data.redis.* at a real server and
            drop this dependency entirely.
        -->
        <dependency>
            <groupId>com.github.codemonstur</groupId>
            <artifactId>embedded-redis</artifactId>
            <version>1.4.4</version>
        </dependency>

        <!-- JPA (Hibernate) + Holon Datastore. tenant-users / tenant-invitations /
             tenant-permissions all require a Holon Datastore bean to auto-configure. -->
        <dependency>
            <groupId>com.holon-platform.jpa</groupId>
            <artifactId>holon-starter-jpa-hibernate</artifactId>
        </dependency>
        <dependency>
            <groupId>com.holon-platform.jpa</groupId>
            <artifactId>holon-datastore-jpa</artifactId>
        </dependency>
        <!-- Spring Data JPA repositories, used for the platform-schema account table. -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-jpa</artifactId>
        </dependency>

        <!-- Vaadin Flow UI -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-spring-boot-starter</artifactId>
        </dependency>
        <!--
            Vaadin's development-mode tooling. It is not a transitive dependency of the starter,
            but running without it fails at startup with "'vaadin-dev-server' not found" unless
            a production frontend bundle has been built. The `production` profile below builds
            that bundle, so this is scoped to ordinary development runs only.
        -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-dev</artifactId>
        </dependency>

        <!-- Schema-per-tenant migrations are executed by Flyway during onboarding. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>

        <!--
            The tenant data-source provider records pool metrics. Micrometer's core API supplies
            the types; the actuator starter supplies an actual MeterRegistry bean for them to be
            registered against. Without the latter the gauges compile, wire and then quietly
            never appear — which is exactly what F24's Internals panel reads back, so the demo
            would be reporting on metrics that do not exist.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Required for the @RequiresPermission aspect to be registered. -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Browser automation for the end-to-end walkthrough. Only used by tests under
            the `e2e` package, which the `e2e` profile below runs against a live server.
        -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>1.63.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
                The end-to-end tests drive a real browser against an already-running
                application, so they cannot take part in the ordinary build.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/e2e/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Runs the browser walkthrough against a server that is already listening on
            APP_URL (http://localhost:8080 by default). Start the application first:
                mvn -pl saas-demo spring-boot:run
            then, in another shell:
                mvn -pl saas-demo test -Pe2e
            Add -De2e.headed=true to watch the browser drive the application.
        -->
        <profile>
            <id>e2e</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludes combine.self="override"/>
                            <includes>
                                <include>**/e2e/*Test.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <e2e.headed>${e2e.headed}</e2e.headed>
                                <e2e.slowMo>${e2e.slowMo}</e2e.slowMo>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
            <properties>
                <e2e.headed>false</e2e.headed>
                <e2e.slowMo>0</e2e.slowMo>
            </properties>
        </profile>

        <!--
            The Vaadin frontend bundle is only built for a production package. In
            development Vaadin builds the frontend on the fly, which keeps the ordinary
            reactor build fast and free of any npm/network requirement.
        -->
        <profile>
            <id>production</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.vaadin</groupId>
                        <artifactId>vaadin-maven-plugin</artifactId>
                        <version>${vaadin.version}</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>prepare-frontend</goal>
                                    <goal>build-frontend</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
