<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.holon-platform.multi-tenancy</groupId>
        <artifactId>holon-multi-tenancy-root</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>holon-starter-multi-tenancy</artifactId>
    <packaging>jar</packaging>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>
        Holon SaaS Starter — the complete, UI-agnostic multi-tenant backend framework:
        core context, data isolation, security, admin backend, onboarding workflow,
        sign-up orchestration, audit log, settings, rate limiting, user management,
        permissions and billing / subscription lifecycle. Import this single dependency
        to bootstrap a production SaaS application's backend, then build any UI
        (Vaadin, React, REST clients, mobile, ...) on top of the exposed services.
    </description>
    <dependencies>
        <!-- Multi-tenant core -->
        <dependency>
            <groupId>com.holon-platform.multi-tenancy</groupId>
            <artifactId>holon-multi-tenant-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.holon-platform.multi-tenancy</groupId>
            <artifactId>holon-multi-tenant-data</artifactId>
        </dependency>
        <dependency>
            <groupId>com.holon-platform.multi-tenancy</groupId>
            <artifactId>holon-multi-tenant-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.holon-platform.multi-tenancy</groupId>
            <artifactId>holon-multi-tenant-admin</artifactId>
        </dependency>
        <dependency>
            <groupId>com.holon-platform.multi-tenancy</groupId>
            <artifactId>holon-multi-tenant-onboarding</artifactId>
        </dependency>
        <dependency>
            <groupId>com.holon-platform.multi-tenancy</groupId>
            <artifactId>holon-multi-tenant-audit</artifactId>
        </dependency>
        <dependency>
            <groupId>com.holon-platform.multi-tenancy</groupId>
            <artifactId>holon-multi-tenant-settings</artifactId>
        </dependency>
        <dependency>
            <groupId>com.holon-platform.multi-tenancy</groupId>
            <artifactId>holon-multi-tenant-limits</artifactId>
        </dependency>
        <dependency>
            <groupId>com.holon-platform.multi-tenancy</groupId>
            <artifactId>holon-multi-tenant-users</artifactId>
        </dependency>
        <dependency>
            <groupId>com.holon-platform.multi-tenancy</groupId>
            <artifactId>holon-multi-tenant-billing</artifactId>
        </dependency>
        <dependency>
            <groupId>com.holon-platform.multi-tenancy</groupId>
            <artifactId>holon-multi-tenant-permissions</artifactId>
        </dependency>
        <dependency>
            <groupId>com.holon-platform.multi-tenancy</groupId>
            <artifactId>holon-multi-tenant-invitations</artifactId>
        </dependency>
        <dependency>
            <groupId>com.holon-platform.multi-tenancy</groupId>
            <artifactId>holon-multi-tenant-quotas</artifactId>
        </dependency>
        <dependency>
            <groupId>com.holon-platform.multi-tenancy</groupId>
            <artifactId>holon-multi-tenant-signup</artifactId>
        </dependency>
        <!-- Security foundation  required for tenant isolation and SecurityContext integration -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.holon-platform.core</groupId>
            <artifactId>holon-spring-security</artifactId>
        </dependency>
        <!-- Optional WhatsApp integration  include it to add the messaging channel -->
        <dependency>
            <groupId>com.holon-platform.multi-tenancy</groupId>
            <artifactId>holon-multi-tenant-whatsapp</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Logging  used by HolonSaasAutoConfiguration -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>
</project>


