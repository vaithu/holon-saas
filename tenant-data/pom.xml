<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.holon-platform.multi-tenancy</groupId>
        <artifactId>holon-multi-tenancy-root</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>holon-multi-tenant-data</artifactId>
    <packaging>jar</packaging>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>Holon SaaS – Multi-tenant data: schema routing, DataSource pool registry, Flyway migration, JPA/Hibernate ORM</description>
    <dependencies>
        <dependency>
            <groupId>com.holon-platform.multi-tenancy</groupId>
            <artifactId>holon-multi-tenant-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.holon-platform.jpa</groupId>
            <artifactId>holon-starter-jpa-hibernate</artifactId>
        </dependency>
        <!-- Required at runtime by the logback-spring.xml bundled inside holon-datastore-jpa-spring-boot -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.holon-platform.jpa</groupId>
            <artifactId>holon-datastore-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.holon-platform.core</groupId>
            <artifactId>holon-spring-boot</artifactId>
        </dependency>
        <!-- Reused instead of declaring our own TenantDataSourceProvider interface —
             com.holonplatform.jdbc.TenantDataSourceProvider (getDataSource(tenantId),
             null = bootstrap/platform connection) is the established convention. -->
        <dependency>
            <groupId>com.holon-platform.jdbc</groupId>
            <artifactId>holon-jdbc</artifactId>
            <version>${holon-core.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Optional: backs the default TenantDataSourceProvider bean, built from
             spring.datasource.* properties (DataSourceProperties) so applications don't have
             to hand-write that wiring themselves. Skipped gracefully when not present. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jdbc</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions><exclusion><groupId>org.junit.vintage</groupId><artifactId>junit-vintage-engine</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive><manifestEntries><Automatic-Module-Name>com.holonplatform.multitenant.data</Automatic-Module-Name></manifestEntries></archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>


