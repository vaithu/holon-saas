<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{60} -- %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Diagnostic-only: surfaces the literal SQL Hibernate executes (and its bind
         parameters) so DefaultSignupServiceTest failures can be root-caused from real
         evidence instead of guesswork. -->
    <logger name="org.hibernate.SQL" level="DEBUG"/>
    <logger name="org.hibernate.orm.jdbc.bind" level="TRACE"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
